generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  SERVER
  KITCHEN
  MANAGER
}

enum TableType {
  STANDARD
  BOOTH
  OUTDOOR
  BAR
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
  PAID
  CANCELLED
}

model Staff {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         StaffRole
  createdAt    DateTime @default(now())
  orders       Order[]

  @@map("staff")
}

model RestaurantTable {
  id          String      @id @default(cuid())
  tableNumber Int         @unique
  tableType   TableType
  seatCount   Int
  status      TableStatus @default(AVAILABLE)
  orders      Order[]

  @@map("restaurant_tables")
}

model MenuItem {
  id          String      @id @default(cuid())
  name        String
  category    String
  unitPrice   Decimal     @db.Decimal(10, 2)
  isAvailable Boolean     @default(true)
  orderItems  OrderItem[]

  @@map("menu_items")
}

model Order {
  id         String      @id @default(cuid())
  table      RestaurantTable @relation(fields: [tableId], references: [id])
  tableId    String
  server     Staff       @relation(fields: [serverId], references: [id])
  serverId   String
  status     OrderStatus @default(PENDING)
  totalValue Decimal     @db.Decimal(10, 2) @default(0)
  items      OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  closedAt   DateTime?

  @@index([tableId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id         String   @id @default(cuid())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId String
  quantity   Int
  unitPrice  Decimal  @db.Decimal(10, 2)
  notes      String?
  isReady    Boolean  @default(false)

  @@index([orderId])
  @@map("order_items")
}
